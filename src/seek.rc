// Executable resources. The icon is generated by assets/make_icon.py.
#include <winver.h>
#include "version.h"

1 ICON "../assets/seek.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SEEK_VERSION_NUM
PRODUCTVERSION SEEK_VERSION_NUM
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SynrgStudio"
            VALUE "FileDescription", "Seek: fast file search for AI agents (MCP server)"
            VALUE "FileVersion", SEEK_VERSION
            VALUE "InternalName", "seek"
            VALUE "LegalCopyright", "GPL-3.0"
            VALUE "OriginalFilename", "seek.exe"
            VALUE "ProductName", "Seek"
            VALUE "ProductVersion", SEEK_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
